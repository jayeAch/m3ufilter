{
  "name": "m3ufilter",
  "version": "1.0.1",
  "description": "M3U playlist filter and proxy server",
  "main": "dist/app-controller.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node --max-old-space-size=768 --optimize-for-size --max-semi-space-size=64 --turbo-filter='M3UFilterStream|handleGetm3u' dist/app-controller.js",
    "pm2:start": "npx pm2 start -i max npm --name \"m3u-filter\" -- run start ecosystem.config.js",
    "pm2:stop": "npx pm2 stop m3u-filter ecosystem.config.js",
    "pm2:restart": "npx pm2 restart m3u-filter ecosystem.config.js",
    "pm2:logs": "npx pm2 logs m3u-filter",
    "pm2:delete": "npx pm2 delete m3u-filter ecosystem.config.js",
    "pm2:save": "npx pm2 save",
    "test": "jest"
  },
  "author": "gewton",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pino": "^10.3.1",
    "pm2": "^6.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "babel-jest": "^30.4.1",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "node-mocks-http": "^1.18.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
